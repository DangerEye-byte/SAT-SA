ws of high/critical cases at each quarter end\n  unannounced      15 reviews in one random month per quarter, all severities\n  satsa_analytics  SAT-SA every month: analytics on all submitted cases (anytime-valid\n                   e-process), completeness check, 5 targeted reviews/month (confirm only)\n  satsa_with_floor SAT-SA analytics + completeness, 2 targeted + 3 uniform-random\n                   reviews per month (the randomised floor)","sims_per_cell":400,"review_budget_per_year":60,"alpha":0.01,"strategies":["honest","delay","drift","cherry_pick","off_audit_drift","attrition","metadata_masking"],"policies":["annual_audit","quarterly_audit","unannounced","satsa_analytics","satsa_with_floor"],"cells":[{"strategy":"honest","policy":"annual_audit","detection_rate":0.015,"median_months_to_detect":12,"detected_by":{"manual review":6}},{"strategy":"honest","policy":"quarterly_audit","detection_rate":0.01,"median_months_to_detect":7.5,"detected_by":{"manual review":4}},{"strategy":"honest","policy":"unannounced","detection_rate":0.0175,"median_months_to_detect":5,"detected_by":{"manual review":7}},{"strategy":"honest","policy":"satsa_analytics","detection_rate":0.0025,"median_months_to_detect":8,"detected_by":{"analytics (anytime-valid e-process)":1}},{"strategy":"honest","policy":"satsa_with_floor","detection_rate":0.015,"median_months_to_detect":5,"detected_by":{"random-floor review":6}},{"strategy":"delay","policy":"annual_audit","detection_rate":0.9175,"median_months_to_detect":6,"detected_by":{"manual review":367}},{"strategy":"delay","policy":"quarterly_audit","detection_rate":0.455,"median_months_to_detect":6,"detected_by":{"manual review":182}},{"strategy":"delay","policy":"unannounced","detection_rate":0.4325,"median_months_to_detect":5,"detected_by":{"manual review":173}},{"strategy":"delay","policy":"satsa_analytics","detection_rate":1,"median_months_to_detect":1,"detected_by":{"analytics (anytime-valid e-process)":399,"completeness: case records missi